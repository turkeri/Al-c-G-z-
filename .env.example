# Gelişmiş analiz proxy adresi.
#
# Boş bırakılırsa uygulama sadece cihaz içi (offline) analiz motoruyla çalışır —
# hiçbir şey bozulmaz, "Detaylı Analiz" bölümü görünmez.
#
# Kurulum adımları: server/README.md
#
# ÖNEMLİ: Buraya API anahtarı YAZILMAZ. Sadece proxy adresi yazılır.
# API anahtarı Cloudflare Worker'da gizli (secret) olarak durur.
VITE_AI_PROXY_URL=

# Supabase Auth istemci ayarları. Gerçek proje oluşturulduktan sonra yalnız
# publishable/anon anahtarı girilir; service-role key burada veya frontend'de olmaz.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production web uygulamasının ve Worker'ın açık HTTPS adresleri.
VITE_API_BASE_URL=
VITE_APP_URL=
